{
  "name": "nube-fullstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:backend": "npm run dev --workspace packages/backend",
    "dev:frontend": "npm run dev --workspace packages/frontend"
  }
}
